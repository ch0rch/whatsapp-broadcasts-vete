# ──────────────────────────────────────────────────────
# vet-platform-mvp — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────

# Supabase — https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Kapso API — https://app.kapso.ai → Settings → API Keys
KAPSO_API_KEY=your-kapso-api-key-here
KAPSO_API_BASE_URL=https://api.kapso.ai

# Kapso Webhooks & Agent Tool Security (shared HMAC secrets)
KAPSO_WEBHOOK_SECRET=your-webhook-hmac-secret-here
KAPSO_AGENT_TOOL_SECRET=your-agent-tool-hmac-secret-here

# WhatsApp / Meta
BUSINESS_ACCOUNT_ID=your-waba-id-here
PHONE_NUMBER_ID=your-phone-number-id-here
NEXT_PUBLIC_PHONE_NUMBER_ID=your-phone-number-id-here

# Cron — random secret for /api/cron/reset-usage (openssl rand -hex 32)
CRON_SECRET=your-cron-secret-here

# Observability (optional for local dev)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
